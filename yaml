name: Manual IFTTT Test

on:
  workflow_dispatch:   # 👈 this adds the "Run workflow" button

jobs:
  hit-webhook:
    runs-on: ubuntu-latest

    steps:
      - name: Trigger IFTTT Webhook
        env:
          WEBHOOK_URL: ${{ secrets.WEBHOOK_URL }}
        run: |
          echo "Calling IFTTT webhook..."
          # POST with some dummy JSON so browser prefetch can't mimic it
          curl -X POST -H "Content-Type: application/json" \
            -d '{"value1":"manual-trigger","value2":"github","value3":"test"}' \
            "$WEBHOOK_URL"
          echo "Webhook fired successfully."
